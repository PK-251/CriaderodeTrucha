# Entorno de pruebas. Laravel carga este archivo automaticamente cuando
# APP_ENV=testing, y sus valores tienen prioridad sobre .env
#
# La base es sippt_test, preparada con ./scripts/preparar_bd_pruebas.sh.
# Ejecutar la suite contra la base de desarrollo haria que las pruebas
# dependieran de los datos que uno tenga cargados en ese momento.
APP_ENV=testing
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_KEY=base64:Yk5wM2hVdjJxOHNMZTRnRmpOemJYcTdBMWRDdEVvSXc=

DB_CONNECTION=pgsql
DB_HOST=postgres-timescale
DB_PORT=5432
DB_DATABASE=sippt_test
DB_USERNAME=sippt
DB_PASSWORD=cambiar_en_local

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BCRYPT_ROUNDS=4
