{
    "name": "sippt/backend-core",
    "description": "Núcleo hexagonal del PMV — Sistema Inteligente para la Optimización de la Producción Piscícola de Trucha",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1",
        "laravel/pint": "^1.20"
    },
    "autoload": {
        "psr-4": {
            "Sippt\\Domain\\": "src/Domain/",
            "Sippt\\Application\\": "src/Application/",
            "Sippt\\Infrastructure\\": "src/Infrastructure/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sippt\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=Unit",
        "analyse": "phpstan analyse --memory-limit=512M",
        "format": "pint",
        "format:check": "pint --test"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
