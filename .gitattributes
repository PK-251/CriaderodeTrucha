# Normalización de finales de línea.
# El repositorio se edita en Windows pero se ejecuta dentro de contenedores
# Linux: un archivo con CRLF rompe los scripts de shell y los entrypoints.
* text=auto eol=lf

# Binarios: nunca normalizar
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.pdf  binary
*.docx binary
*.ico  binary
*.woff  binary
*.woff2 binary

# Archivos que deben conservar LF sí o sí
*.sh          text eol=lf
*.py          text eol=lf
*.php         text eol=lf
*.sql         text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.conf        text eol=lf
Dockerfile    text eol=lf
*.Dockerfile  text eol=lf
.env.example  text eol=lf
