APP_NAME=SIPPT
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres-timescale
DB_PORT=5432
DB_DATABASE=sippt
DB_USERNAME=sippt
DB_PASSWORD=cambiar_en_local

SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync

MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_TOPIC_ALERTAS=piscigranja/alertas

MAIL_MAILER=log
MAIL_FROM_ADDRESS=alertas@sippt.local
MAIL_FROM_NAME="SIPPT Alertas"
ALERTA_CRITICA_DESTINO=tecnico@sippt.local
