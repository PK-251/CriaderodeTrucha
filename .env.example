# ─────────────────────────────────────────────────────────────────────────────
# SIPPT — Sistema Inteligente para la Optimización de la Producción Piscícola
# Primer Incremento (PMV) · v0.1.0-pmv
#
# Copia este archivo a .env antes de levantar el entorno:
#   cp .env.example .env
# Nunca subas .env al repositorio (está en .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ── General ──────────────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=sippt
# Zona horaria de la piscigranja. Debe coincidir con el offset que envían los
# nodos sensores en medido_en (-05:00), porque la marca temporal la pone el
# nodo y no el servidor (RNF-02).
TZ=America/Lima

# ── Base de datos · PostgreSQL 16 + TimescaleDB ──────────────────────────────
POSTGRES_DB=sippt
POSTGRES_USER=sippt
POSTGRES_PASSWORD=cambiar_en_local
POSTGRES_HOST=postgres-timescale
POSTGRES_PORT=5432
# Puerto expuesto en el host (cámbialo si ya tienes un Postgres local)
POSTGRES_HOST_PORT=5432

# ── Backend · api-core (Laravel 11 / PHP 8.3) ────────────────────────────────
APP_NAME=SIPPT
APP_ENV=local
APP_DEBUG=true
# Se genera en la Fase 3 con: php artisan key:generate
APP_KEY=
APP_URL=http://localhost:8000
API_HOST_PORT=8000

# Conexión de Laravel a la base (mismos valores que el bloque POSTGRES_*)
DB_CONNECTION=pgsql
DB_HOST=postgres-timescale
DB_PORT=5432
DB_DATABASE=sippt
DB_USERNAME=sippt
DB_PASSWORD=cambiar_en_local

# ── Broker MQTT · Mosquitto ──────────────────────────────────────────────────
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_HOST_PORT=1883
# Contrato del tópico: piscigranja/{codigo_estanque}/{parametro}
MQTT_TOPIC_BASE=piscigranja
MQTT_CLIENT_ID=sippt-ingesta
MQTT_QOS=1

# ── Servicio de ingesta (Python 3.12 / FastAPI / paho-mqtt) ──────────────────
INGESTA_HOST_PORT=8001
# URL interna del núcleo para el envío por lote a POST /api/v1/lecturas
CORE_API_URL=http://api-core:8000/api/v1
# Token Bearer del servicio de ingesta (se emite en la Fase 3)
CORE_API_TOKEN=
# Tamaño del lote y ventana de acumulación antes de enviar al núcleo
INGESTA_BATCH_SIZE=50
INGESTA_BATCH_INTERVAL_S=30
# Búfer local persistente para el corte de enlace (RNF-02)
INGESTA_BUFFER_PATH=/data/buffer.sqlite3
INGESTA_MAX_REINTENTOS=5

# ── Tablero · dashboard (Next.js 14 / Node 20) ───────────────────────────────
DASHBOARD_HOST_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
# Un estanque que no reporta hace más de este tiempo se marca como
# "sin comunicación" en el tablero (HU-03).
NEXT_PUBLIC_SIN_COMUNICACION_MIN=15

# ── Notificación de alertas críticas por correo (HU-04) ──────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=alertas@sippt.local
MAIL_FROM_NAME="SIPPT Alertas"
# Destinatario de las alertas de severidad crítica
ALERTA_CRITICA_DESTINO=tecnico@sippt.local

# ── Parámetros operativos del PMV ────────────────────────────────────────────
# Intervalo de muestreo de los nodos sensores, en minutos (HU-02: cada 5 min
# → 288 lecturas diarias por sensor).
SENSOR_INTERVALO_MIN=5
